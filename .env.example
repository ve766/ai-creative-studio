# AI Creative Studio - environment template
# Copy to .env.local (web) and fill in real values. NEVER commit real secrets.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AI 文创设计工坊"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# dev | preview | production
APP_ENV="dev"

# ---------------------------------------------------------------------------
# Managed database + auth (Supabase) - Phase 2, optional in Phase 1
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2 / Supabase Storage) - Phase 2, optional
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=""
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# AI providers - Phase 3+, optional. If empty the UI shows "not configured".
# ---------------------------------------------------------------------------
AI_IMAGE_PROVIDER=""
AI_IMAGE_API_KEY=""
AI_IMAGE_BASE_URL=""
AI_BG_REMOVAL_PROVIDER=""
AI_BG_REMOVAL_API_KEY=""
AI_SCENE_PROVIDER=""
AI_SCENE_API_KEY=""

# ---------------------------------------------------------------------------
# Payments - Phase 7, optional
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
