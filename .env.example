# AI Creative Studio - environment template
# Copy to .env.local (web) and fill in real values. NEVER commit real secrets.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AI 文创设计工坊"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# dev | preview | production
APP_ENV="dev"

# ---------------------------------------------------------------------------
# Cloud project storage (Phase 4)
# local = browser only (default) | mock = in-memory dev fake (never in production)
# | cloud = requires DATABASE_URL + CLOUD_PROJECT_STORE
# See docs/cloud-setup.md. Empty values keep the app on local storage.
# ---------------------------------------------------------------------------
CLOUD_MODE=""
CLOUD_PROJECT_STORE=""

# ---------------------------------------------------------------------------
# Managed database + auth (Supabase) - required when CLOUD_MODE=cloud
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
DATABASE_URL=""

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2 / Supabase Storage) - Phase 2, optional
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=""
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""

# ---------------------------------------------------------------------------
# AI providers - Phase 5. AI_MODE: off (default) | mock | live
#   off  = AI 功能关闭，接口返回 NOT_CONFIGURED
#   mock = 开发模拟（仅非生产环境）：结果一律标记为模拟，不产生费用
#   live = 真实 Provider；当前**没有实现任何真实适配器**，因此该模式只会
#          报告「未配置」，即使填好下列密钥也不会发起调用
# 未配置时界面显示「未配置」，绝不显示假的 AI 成功状态。
# ---------------------------------------------------------------------------
AI_MODE=""
AI_IMAGE_PROVIDER=""
AI_IMAGE_API_KEY=""
AI_IMAGE_BASE_URL=""
AI_BG_REMOVAL_PROVIDER=""
AI_BG_REMOVAL_API_KEY=""
AI_SCENE_PROVIDER=""
AI_SCENE_API_KEY=""

# ---------------------------------------------------------------------------
# Payments - Phase 7, optional
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER=""
PAYMENT_SECRET_KEY=""
PAYMENT_WEBHOOK_SECRET=""
